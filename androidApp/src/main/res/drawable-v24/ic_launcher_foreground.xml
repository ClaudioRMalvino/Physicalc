<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground layer: a projectile-motion trajectory.

    The viewport is 108x108 but launchers mask the icon, so all artwork stays
    inside the central ~66dp "safe zone" (roughly 21..87 on each axis).

    Elements:
      - a short ground line where the launch starts
      - the parabolic flight arc
      - the projectile itself at the arc's end
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground line -->
    <path
        android:pathData="M26,80 L56,80"
        android:fillColor="#00000000"
        android:strokeColor="#5A6E94"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Trajectory arc (quadratic Bezier approximating a parabola) -->
    <path
        android:pathData="M28,78 Q50,16 78,46"
        android:fillColor="#00000000"
        android:strokeColor="#D7E3FF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Projectile -->
    <path
        android:pathData="M80,48 m-8,0 a8,8 0 1,1 16,0 a8,8 0 1,1 -16,0"
        android:fillColor="#8AB4FF" />
</vector>
